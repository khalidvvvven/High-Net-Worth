---
/**
 * Sense of place without a stock or mislabelled photograph: a typographic
 * band that repeats the hero's ribbon-and-seal "spine" between the statement
 * and the office details.
 */
import { firm } from '../content/site';
import Seal from './Seal.astro';
import Icon from './Icon.astro';

interface Props {
  id?: string;
}
const { id = 'location' } = Astro.props;
---

<section class="location section--dark" aria-labelledby={`${id}-title`}>
  <div class="container location__grid">
    <div class="location__copy" data-reveal>
      <p class="eyebrow">Lafayette, Louisiana</p>
      <h2 id={`${id}-title`} class="h2">In downtown Lafayette, <em class="accent-italic">serving Acadiana.</em></h2>
      <p class="location__text">
        The office is located on West Main Street in downtown Lafayette and represents clients in Lafayette and across
        the Acadiana region.
      </p>
    </div>

    <div class="location__spine" aria-hidden="true">
      <div class="location__ribbon"></div>
      <div class="location__seal"><Seal id={`${id}-seal`} /></div>
    </div>

    <div class="location__office" data-reveal>
      <p class="label location__label">The Office</p>
      <address class="location__address">
        {firm.address.street}, <span class="nowrap">{firm.address.suite}</span><br />
        {firm.address.city}, {firm.address.region} <span class="nowrap">{firm.address.postalCode}</span>
      </address>
      <p class="location__parish">Lafayette Parish <span aria-hidden="true">·</span> Acadiana</p>
      <a class="link-arrow" href={firm.directionsUrl} target="_blank" rel="noopener">
        Get directions <Icon name="arrow" size={16} /><span class="visually-hidden"> (opens Google Maps in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .location {
    --pad: clamp(4.5rem, 3rem + 5vw, 8rem);
    position: relative;
    overflow: hidden;
    padding-block: var(--pad);
    background: var(--oxblood-800);
    color: var(--ivory-100);
  }
  .location::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 120% at 0% 0%, rgba(148, 41, 58, 0.35), transparent 60%);
    pointer-events: none;
  }
  .location__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) 11rem minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 3rem);
  }
  .location__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .location__text {
    max-width: 44ch;
    font-size: 1.0625rem;
    color: rgba(247, 242, 234, 0.82);
  }
  .location__spine {
    position: relative;
    align-self: stretch;
    min-height: 14rem;
  }
  .location__ribbon {
    position: absolute;
    top: calc(-1 * var(--pad));
    bottom: calc(-1 * var(--pad));
    left: 50%;
    width: 4rem;
    transform: translateX(-50%);
    background: var(--oxblood-600);
  }
  .location__ribbon::before,
  .location__ribbon::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-image: radial-gradient(circle at 1.5px 1.5px, var(--gold-300) 0.85px, transparent 1.15px);
    background-size: 3px 7px;
    opacity: 0.75;
  }
  .location__ribbon::before {
    left: 7px;
  }
  .location__ribbon::after {
    right: 7px;
  }
  .location__seal {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9rem;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 10px 24px rgba(20, 5, 8, 0.35));
  }
  .location__office {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .location__label {
    color: var(--gold-300);
  }
  .location__address {
    font-style: normal;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.3;
    color: var(--ivory-50);
  }
  .nowrap {
    white-space: nowrap;
  }
  .location__parish {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 242, 234, 0.7);
  }

  @media (max-width: 899px) {
    .location__grid {
      grid-template-columns: 1fr;
    }
    .location__spine {
      display: none;
    }
    .location__office {
      margin-top: 2.75rem;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(247, 242, 234, 0.18);
    }
  }
</style>
