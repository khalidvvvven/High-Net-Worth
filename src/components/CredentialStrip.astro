---
import { credentials } from '../content/site';
---

<section class="credentials" aria-labelledby="credentials-title">
  <h2 id="credentials-title" class="visually-hidden">Credentials and recognition</h2>
  <div class="container">
    <ul role="list" class="credentials__list">
      {
        credentials.map((c) => (
          <li class:list={['credential', `credential--${c.id}`]} data-reveal>
            <span class="credential__label">{c.label}</span>
            <span class="credential__title">{c.title}</span>
            <span class="credential__issuer">{c.issuer}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .credentials {
    position: relative;
    background: var(--bg-raised);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .credentials__list {
    display: grid;
    grid-template-columns: 1.05fr 1.25fr 1fr 1fr 0.95fr;
  }
  .credential {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1.75rem, 1rem + 2vw, 2.75rem) clamp(1rem, 0.4rem + 1.4vw, 2rem);
    border-left: 1px solid var(--rule);
  }
  .credential:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .credential:last-child {
    padding-right: 0;
  }
  .credential__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--oxblood-600);
  }
  .credential__title {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.65rem);
    line-height: 1.15;
    color: var(--ink-900);
    font-feature-settings: 'lnum' 1;
    text-wrap: balance;
  }
  .credential__issuer {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-700);
  }

  @media (max-width: 1099px) {
    .credentials__list {
      grid-template-columns: repeat(6, 1fr);
    }
    .credential {
      grid-column: span 2;
      border-top: 1px solid var(--rule);
    }
    .credential:nth-child(-n + 3) {
      border-top: 0;
    }
    .credential:nth-child(4),
    .credential:nth-child(5) {
      grid-column: span 3;
    }
    .credential:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 639px) {
    .credentials__list {
      grid-template-columns: 1fr 1fr;
    }
    .credential,
    .credential:nth-child(4),
    .credential:nth-child(5) {
      grid-column: span 1;
      border-top: 1px solid var(--rule);
      padding: 1.5rem 0 1.5rem 1rem;
    }
    .credential:nth-child(even) {
      border-left: 0;
      padding-left: 0;
      padding-right: 1rem;
    }
    .credential:nth-child(odd) {
      border-left: 1px solid var(--rule);
    }
    .credential:first-child {
      grid-column: 1 / -1;
      border-top: 0;
      border-left: 0;
      padding: 1.75rem 0 1.5rem;
    }
    .credential:nth-child(2),
    .credential:nth-child(3) {
      border-top: 1px solid var(--rule);
    }
    .credential__title {
      font-size: 1.2rem;
    }
    .credential__label {
      letter-spacing: 0.12em;
    }
  }
</style>
